# Copy this file to ".env" and fill in your values. Never commit .env.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Local MongoDB:  mongodb://127.0.0.1:27017/parkshare
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/parkshare
MONGODB_URI=mongodb://127.0.0.1:27017/parkshare

# At least 32 characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=1d
JWT_EXPIRES_REMEMBER=30d

# The single admin account, created by "npm run seed:admin". Choose your own; there is no default.
ADMIN_NAME=ParkShare Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to 1 when deployed behind a hosting proxy (Render, Railway, etc.). Leave empty locally.
TRUST_PROXY=
